# Стенд для e2e: docker compose --env-file e2e/stack.env --profile fakes. ТОЛЬКО ДЛЯ ТЕСТОВ —
# секреты ниже публичны и не годятся ни для какой установки.
PLATFORM_SECRET_KEY=ZTJlLW9ubHktbm90LWEtc2VjcmV0LWtleS0zMmJ5dGU=
PLATFORM_DB_PASSWORD=e2e-only-db-password
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=e2e-only-Admin-password-1
COOKIE_SECURE=false
# e2e входит десятки раз подряд с одного адреса — лимит шлюза на вход поднят
LOGIN_RATE_PER_MINUTE=600
LOGIN_RATE_BURST=300
PLATFORM_GATEWAY_PORT=18090
PLATFORM_API_PORT=18010
PLATFORM_DB_PORT=15440
# API и страница продукта — одна и та же заглушка (страница отдаётся на /)
SCANNER_API_UPSTREAM=http://fake-scanner:8000
SCANNER_WEB_UPSTREAM=http://fake-scanner:8000
VM_API_UPSTREAM=http://fake-vm:8000
VM_WEB_UPSTREAM=http://fake-vm:8000
GRC_API_UPSTREAM=http://fake-grc:8000
GRC_WEB_UPSTREAM=http://fake-grc:8000
SCANNER_EVENTS_SECRET=e2e-only-scanner-events-secret
VM_EVENTS_SECRET=e2e-only-vm-events-secret
GRC_EVENTS_SECRET=e2e-only-grc-events-secret
# Четвёртый продукт: подключается только переменными (roadmap §1а); нужен teams.spec.ts (матрица ролей).
PLATFORM_PRODUCTS=scanner,vm,grc,demo
DEMO_API_UPSTREAM=http://fake-demo:8000
DEMO_WEB_UPSTREAM=http://fake-demo:8000
DEMO_EVENTS_SECRET=e2e-only-demo-events-secret
