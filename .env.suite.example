# ===== Комплект «Платформа» + продукты: переменные окружения. =====
# cp .env.suite.example .env, заполните и запустите: deploy/suite.sh up -d --wait
# Подробно — docs/INSTALL.md, раздел «Комплект».
#
# Пароли БД — только [A-Za-z0-9] (они попадают в DATABASE_URL), не короче 16 символов: openssl rand -hex 24

# --- Продукты установки ---
# id через запятую. Новый продукт = id здесь + блок переменных <ID>_* ниже (roadmap §1а).
PLATFORM_PRODUCTS=scanner,vm,grc

# --- Платформа (обязательно) ---
# Ключ AES-GCM для приватных ключей подписи: openssl rand -base64 32. Храните отдельно от резервных копий.
PLATFORM_SECRET_KEY=
# Суперпользователь кластера PostgreSQL: нужен только db-init и скриптам backup/restore, приложениям не передаётся.
POSTGRES_SUPERUSER_PASSWORD=
# Пользователь platform (права только на базу platform).
PLATFORM_DB_PASSWORD=

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Администратор платформы

# Образы платформы. Пусто — собираются из этого репозитория (deploy/suite.sh build).
# PLATFORM_API_IMAGE=registry.local/platform/api:1.0.0
# PLATFORM_WEB_IMAGE=registry.local/platform/web:1.0.0
# PLATFORM_GATEWAY_IMAGE=registry.local/platform/gateway:1.0.0

# --- «Сканер» (scanner) ---
# Образ API продукта (сервис scanner-app, порт 8000) и web-образ со SPA, собранной с VITE_BASE=/scanner/ (порт 8080).
SCANNER_IMAGE=registry.local/scanner/app:1.0.0
SCANNER_WEB_IMAGE=registry.local/scanner/web:1.0.0
# Пользователь и база scanner: права только на свою базу.
SCANNER_DB_PASSWORD=
# HMAC событий, openssl rand -hex 32; продукт получает его как PLATFORM_EVENTS_SECRET.
SCANNER_EVENTS_SECRET=
# Большой лимит тела для загрузки выгрузки БДУ ФСТЭК (переменные шлюза, шаг М.1).
SCANNER_LARGE_UPLOAD_PATHS=/feeds/bdu/upload
SCANNER_LARGE_UPLOAD_MAX_BODY=512m
# Адреса для шлюза и API по умолчанию — сервисы комплекта (http://scanner-app:8000, http://scanner-web:8080).
# Задайте явно, только если продукт работает вне комплекта:
# SCANNER_API_UPSTREAM=http://scanner.internal:8000
# SCANNER_WEB_UPSTREAM=http://scanner.internal:8080

# --- «Устранение» (vm) ---
VM_IMAGE=registry.local/vm/app:1.0.0
VM_WEB_IMAGE=registry.local/vm/web:1.0.0
VM_DB_PASSWORD=
VM_EVENTS_SECRET=

# --- «Аттестация» (grc) ---
GRC_IMAGE=registry.local/grc/app:1.0.0
GRC_WEB_IMAGE=registry.local/grc/web:1.0.0
GRC_DB_PASSWORD=
GRC_EVENTS_SECRET=

# Собственные настройки продукта (его секреты, лимиты и т. п.) — в deploy/env/<id>.env, по образцу
# deploy/env/example.env. Комплект сам передаёт каждому продукту: AUTH_MODE=platform, DATABASE_URL,
# PLATFORM_URL, PLATFORM_JWKS_URL, PLATFORM_EVENTS_URL, PLATFORM_EVENTS_SECRET, PLATFORM_PRODUCT_ID.

# --- Порты хоста ---
PLATFORM_GATEWAY_BIND=127.0.0.1
PLATFORM_GATEWAY_PORT=18090
PLATFORM_GATEWAY_TLS_PORT=18443
# API платформы и PostgreSQL — только на 127.0.0.1, для отладки. Продукты наружу не публикуются: только через шлюз.
PLATFORM_API_PORT=18010
PLATFORM_DB_PORT=15440

# --- Шлюз ---
SERVER_NAME=_
CLIENT_MAX_BODY=20m
TLS_DIR=./deploy/tls
TLS_CERT=
TLS_KEY=

# --- Вход ---
# false — только для стенда без TLS
COOKIE_SECURE=true
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# --- Ключи подписи (см. docs/INSTALL.md, «Ключи подписи») ---
KEY_ROTATION_DAYS=90
KEY_NEXT_LEAD_SECONDS=1200
JWKS_RETAIN_SECONDS=1800
