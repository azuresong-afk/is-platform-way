# ===== «Платформа»: переменные окружения. Скопируйте в .env и заполните. =====

# --- Секреты (обязательно) ---
# Ключ AES-GCM для приватных ключей подписи: openssl rand -base64 32
PLATFORM_SECRET_KEY=
# Пароль пользователя БД платформы
PLATFORM_DB_PASSWORD=

# --- Первый администратор (создаётся, только если пользователей ещё нет) ---
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Администратор платформы

# --- Порты хоста (контракт v1, п. 1) ---
# 0.0.0.0 — открыть шлюз в сеть; по умолчанию только локально
PLATFORM_GATEWAY_BIND=127.0.0.1
PLATFORM_GATEWAY_PORT=18090
PLATFORM_GATEWAY_TLS_PORT=18443
# API и БД публикуются только на 127.0.0.1 — для отладки
PLATFORM_API_PORT=18010
PLATFORM_DB_PORT=15440

# --- Продукты установки ---
# Внутренний адрес API продукта (без /api/<id>). Пусто — продукта нет в кабинете.
# Ниже — заглушки из профиля fakes; для настоящих продуктов: http://scanner-app:8000 и т. п.
SCANNER_API_UPSTREAM=http://fake-scanner:8000
VM_API_UPSTREAM=http://fake-vm:8000
GRC_API_UPSTREAM=http://fake-grc:8000
# Адрес web-контейнера продукта (SPA собрана с VITE_BASE=/<id>/). Пусто — шлюз не отдаёт /<id>/.
SCANNER_WEB_UPSTREAM=
VM_WEB_UPSTREAM=
GRC_WEB_UPSTREAM=
# Секреты HMAC событий, свой на каждый продукт, не короче 16 символов: openssl rand -hex 32
SCANNER_EVENTS_SECRET=
VM_EVENTS_SECRET=
GRC_EVENTS_SECRET=

# --- Шлюз ---
SERVER_NAME=_
CLIENT_MAX_BODY=20m
# Загрузка выгрузки БДУ ФСТЭК в «Сканер»
BDU_UPLOAD_MAX_BODY=512m
# TLS: положите fullchain.pem и privkey.pem в TLS_DIR и укажите пути внутри контейнера
TLS_DIR=./deploy/tls
# TLS_CERT=/etc/nginx/tls/fullchain.pem
# TLS_KEY=/etc/nginx/tls/privkey.pem
TLS_CERT=
TLS_KEY=

# --- Вход ---
# false — только для локальной разработки по http
COOKIE_SECURE=true
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# --- Заглушки ---
# Больше 5 — проверить карточку «Недоступен» на Главной
FAKE_GRC_DELAY_SECONDS=0
