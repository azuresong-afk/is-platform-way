# ===== «Платформа»: переменные окружения. Скопируйте в .env и заполните. =====

# --- Секреты (обязательно) ---
# Ключ AES-GCM для приватных ключей подписи: openssl rand -base64 32
PLATFORM_SECRET_KEY=
# Пароль пользователя БД платформы
PLATFORM_DB_PASSWORD=

# --- Первый администратор (создаётся, только если пользователей ещё нет) ---
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Администратор платформы

# --- Порты хоста (контракт v1, п. 1) ---
# 0.0.0.0 — открыть шлюз в сеть; по умолчанию только локально
PLATFORM_GATEWAY_BIND=127.0.0.1
PLATFORM_GATEWAY_PORT=18090
PLATFORM_GATEWAY_TLS_PORT=18443
# API и БД публикуются только на 127.0.0.1 — для отладки
PLATFORM_API_PORT=18010
PLATFORM_DB_PORT=15440

# --- Продукты установки ---
# Список id продуктов через запятую; порядок — порядок вкладок (если манифест не задаёт "order").
# Новый продукт: добавьте id сюда и задайте <ID>_API_UPSTREAM, <ID>_WEB_UPSTREAM, <ID>_EVENTS_SECRET
# (см. docs/INSTALL.md, «Подключение нового продукта»). id: a-z и цифры, 2–20 символов.
PLATFORM_PRODUCTS=scanner,vm,grc
# Внутренний адрес API продукта (без /api/<id>). Пусто — продукта нет в кабинете.
# Ниже — заглушки из профиля fakes; для настоящих продуктов: http://scanner-app:8000 и т. п.
SCANNER_API_UPSTREAM=http://fake-scanner:8000
VM_API_UPSTREAM=http://fake-vm:8000
GRC_API_UPSTREAM=http://fake-grc:8000
# Адрес web-контейнера продукта (SPA собрана с VITE_BASE=/<id>/). Пусто — шлюз не отдаёт /<id>/.
SCANNER_WEB_UPSTREAM=
VM_WEB_UPSTREAM=
GRC_WEB_UPSTREAM=
# Секреты HMAC событий, свой на каждый продукт, не короче 16 символов: openssl rand -hex 32
SCANNER_EVENTS_SECRET=
VM_EVENTS_SECRET=
GRC_EVENTS_SECRET=

# Пути API продукта с большим телом запроса (относительно /api/<id>/, через пробел) и лимит для них.
# «Сканер»: загрузка выгрузки БДУ ФСТЭК (vullist.xlsx).
SCANNER_LARGE_UPLOAD_PATHS=/feeds/bdu/upload
SCANNER_LARGE_UPLOAD_MAX_BODY=512m

# Пример четвёртого продукта (заглушка fake-demo из профиля fakes): допишите demo в PLATFORM_PRODUCTS.
# DEMO_API_UPSTREAM=http://fake-demo:8000
# DEMO_WEB_UPSTREAM=
# DEMO_EVENTS_SECRET=

# --- Шлюз ---
SERVER_NAME=_
CLIENT_MAX_BODY=20m
# TLS: положите fullchain.pem и privkey.pem в TLS_DIR и укажите пути внутри контейнера
TLS_DIR=./deploy/tls
# TLS_CERT=/etc/nginx/tls/fullchain.pem
# TLS_KEY=/etc/nginx/tls/privkey.pem
TLS_CERT=
TLS_KEY=

# --- Вход ---
# false — только для локальной разработки по http
COOKIE_SECURE=true
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# Лимит шлюза на вход и сервисные токены с одного IP: запросов в минуту и запас подряд.
# За внешним балансировщиком все клиенты для шлюза — один адрес: см. docs/SECURITY.md, п. 7.
LOGIN_RATE_PER_MINUTE=10
LOGIN_RATE_BURST=30
# Swagger UI и схема OpenAPI на /api/platform/docs — только для разработки
API_DOCS=false

# --- Ключи подписи (экран «Администрирование → Ключи подписи») ---
# Плановая смена раз в N дней
KEY_ROTATION_DAYS=90
# Новый ключ публикуется в JWKS заранее и подписывает не раньше чем через столько секунд
# (должно быть больше кэша JWKS в продуктах — 600 с)
KEY_NEXT_LEAD_SECONDS=1200
# Сколько прежний ключ остаётся в JWKS после смены (не меньше срока access-токена — 900 с)
JWKS_RETAIN_SECONDS=1800

# --- Заглушки ---
# Больше 5 — проверить карточку «Недоступен» на Главной
FAKE_GRC_DELAY_SECONDS=0
